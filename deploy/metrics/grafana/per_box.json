{
  "title": "frameforge — per box",
  "uid": "frameforge-per-box",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "15s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["30m", "1h", "6h", "12h", "24h", "3d", "7d", "14d"]
  },
  "templating": {
    "list": [
      {
        "name": "cam",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(acq_camera_alive, cam)",
        "multi": true,
        "includeAll": true,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Camera alive (per cam)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "acq_camera_alive{cam=~\"$cam\"}", "legendFormat": "{{cam}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2,
      "title": "Broadcast alive (per cam)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "bcast_session_alive{cam=~\"$cam\"}", "legendFormat": "{{cam}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 3,
      "title": "SMB session alive",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "transfer_session_alive", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 4,
      "title": "Scratch free",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "transfer_free_mb", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "decmbytes", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1000}, {"color": "green", "value": 5000}]}}}
    },
    {
      "id": 5,
      "title": "Frames processed (per cam, cumulative)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 3, "w": 6, "h": 3},
      "targets": [{"expr": "acq_loop_duration_seconds_count{cam=~\"$cam\"}", "legendFormat": "{{cam}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "description": "Acq loop iterations that completed successfully (frame grabbed + queued to encoder). Excludes incomplete + missed + overrun drops."
    },
    {
      "id": 6,
      "title": "Drops (per cam, cumulative; overrun + missed + incomplete)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 3, "w": 6, "h": 3},
      "targets": [
        {"expr": "(acq_overrun_drops_total{cam=~\"$cam\"} or vector(0)) + (acq_missed_frames_total{cam=~\"$cam\"} or vector(0)) + (acq_incomplete_total{cam=~\"$cam\"} or vector(0))", "legendFormat": "{{cam}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 7,
      "title": "Chunks uploaded (cumulative)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 3, "w": 6, "h": 3},
      "targets": [{"expr": "transfer_uploaded_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 8,
      "title": "Chunks discarded (cumulative)",
      "type": "stat",
      "gridPos": {"x": 18, "y": 3, "w": 6, "h": 3},
      "targets": [{"expr": "transfer_discarded_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 9,
      "title": "Acquisition loop latency — p50 / p95 / p99 (aggregated across cams)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(acq_loop_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(acq_loop_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(acq_loop_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 10,
      "title": "Encoder per-frame latency — p50 / p95 / p99 (aggregated)",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(enc_encode_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(enc_encode_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(enc_encode_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 11,
      "title": "Broadcast per-frame latency — p50 / p95 / p99 (aggregated)",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(bcast_encode_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(bcast_encode_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(bcast_encode_duration_seconds_bucket{cam=~\"$cam\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 12,
      "title": "Drops per minute (per cam, by type)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(acq_overrun_drops_total{cam=~\"$cam\"}[$__rate_interval]) * 60", "legendFormat": "overrun {{cam}}", "refId": "A"},
        {"expr": "rate(acq_missed_frames_total{cam=~\"$cam\"}[$__rate_interval]) * 60", "legendFormat": "missed {{cam}}", "refId": "B"},
        {"expr": "rate(acq_incomplete_total{cam=~\"$cam\"}[$__rate_interval]) * 60", "legendFormat": "incomplete {{cam}}", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 13,
      "title": "Ring free slots + queue depth (per cam)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "acq_enc_ring_free{cam=~\"$cam\"}", "legendFormat": "ring free {{cam}}", "refId": "A"},
        {"expr": "acq_enc_queue_depth{cam=~\"$cam\"}", "legendFormat": "queue depth {{cam}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 14,
      "title": "Transfer rate (per minute)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 6},
      "targets": [
        {"expr": "rate(transfer_uploaded_total[$__rate_interval]) * 60", "legendFormat": "uploaded", "refId": "A"},
        {"expr": "rate(transfer_failures_total[$__rate_interval]) * 60", "legendFormat": "failures", "refId": "B"},
        {"expr": "rate(transfer_discarded_total[$__rate_interval]) * 60", "legendFormat": "discarded", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 15,
      "title": "Per-worker RSS",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 6},
      "targets": [{"expr": "worker_rss_mb", "legendFormat": "{{worker}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "id": 16,
      "title": "Host CPU busy ratio",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 6},
      "targets": [{"expr": "host_cpu_busy_ratio", "legendFormat": "cpu busy", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 17,
      "title": "Host memory available",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 6},
      "targets": [{"expr": "host_mem_available_mb", "legendFormat": "mem avail", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "id": 18,
      "title": "Worker restarts (cumulative, per worker)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 34, "w": 12, "h": 6},
      "targets": [{"expr": "sv_worker_restarts_total", "legendFormat": "{{worker}}", "refId": "A"}]
    },
    {
      "id": 19,
      "title": "Frameforge uptime",
      "type": "stat",
      "gridPos": {"x": 12, "y": 34, "w": 12, "h": 6},
      "targets": [{"expr": "frameforge_uptime_seconds", "legendFormat": "uptime", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
