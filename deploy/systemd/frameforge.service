# Install + bringup: see deploy/SETUP.md

[Unit]
Description=frameforge camera acquisition (MS-01)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=talmolab
Group=talmolab
WorkingDirectory=/usr/local/lib/frameforge

Environment=FF_HARDWARE=ms01
EnvironmentFile=/etc/frameforge/secrets.env

RuntimeDirectory=frameforge/prom
RuntimeDirectoryMode=0755

ExecStart=/usr/local/lib/frameforge/.venv/bin/python3 -m frameforge

Restart=no

# Two-signal drain:
#   SIGTERM (systemctl stop)        -> soft, finish current chunk (up to chunk_seconds)
#   SIGINT  (systemctl kill -s INT) -> hard, finalize partial mp4 immediately
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=3800

[Install]
WantedBy=multi-user.target
