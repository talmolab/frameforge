# systemd unit for frameforge on the Jetson (bench profile).
#
# Install:
#   sudo cp deploy/frameforge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now frameforge
#
# Secrets:
#   sudo install -d -m 700 /etc/frameforge
#   sudoedit /etc/frameforge/secrets.env       # see template below; chmod 600
#
#     VAST_USER=cdracos
#     VAST_PASS=...
#
# Logs:
#   journalctl -u frameforge -f
#   tail -f /home/charlie/frameforge/logs/frameforge.log

[Unit]
Description=frameforge camera acquisition
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=charlie
WorkingDirectory=/home/charlie/Projects/frameforge

Environment=FF_PROFILE=bench
Environment=FF_SCRATCH=/home/charlie/Projects/frameforge/scratch
Environment=FF_LOG_DIR=/home/charlie/Projects/frameforge/logs
Environment=PROMETHEUS_MULTIPROC_DIR=/run/frameforge/prom
EnvironmentFile=/etc/frameforge/secrets.env

# /run/frameforge/prom is the mmap-file dir for prom_client multi-process
# mode (workers write, metrics exporter aggregates). systemd creates +
# cleans it; the supervisor also rm -rf's on start as belt-and-suspenders.
RuntimeDirectory=frameforge/prom
RuntimeDirectoryMode=0755

ExecStart=/usr/bin/python3 -m frameforge

Restart=no

# Two-signal drain (see docs/deployment.md).
#   SIGTERM -> soft drain: encoder finishes current chunk, then exits.
#               `systemctl stop frameforge` can take up to ~1h.
#   SIGINT  -> hard drain: immediate, partial mp4 finalized.
#               Trigger via `systemctl kill -s INT frameforge`.
# KillMode=mixed sends the signal only to the supervisor; child workers
# react to the shared drain events, not to signals.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=3700

[Install]
WantedBy=multi-user.target
